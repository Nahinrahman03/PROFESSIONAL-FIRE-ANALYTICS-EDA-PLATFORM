FLASK_ENV=production
SECRET_KEY=change-me-in-production
# Optional: absolute path to a CSV file. If omitted, the first CSV in data/raw is used.
DATASET_PATH=
MAP_POINT_LIMIT=5000

# Server configuration (optional)
# PORT=8501
# HOST=0.0.0.0

# Alerting — custom JSON file path for persistent rules (defaults to data/alerts.json)
# ALERTS_FILE=data/alerts.json

# Alerting — optional email notifications (leave blank to disable email delivery)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=your@gmail.com
